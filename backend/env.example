# ============================================
# Backend Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to git!

# Server Configuration
NODE_ENV=production
PORT=5001

# MongoDB Configuration
# For MongoDB Atlas (recommended for production):
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/wnr?retryWrites=true&w=majority
# OR for local MongoDB:
# MONGO_URI=mongodb://127.0.0.1:27017/wnr

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Firebase Admin (for authentication)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Razorpay Configuration
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Eshopbox Configuration (for shipping)
ESHOPBOX_CLIENT_ID=your-eshopbox-client-id
ESHOPBOX_SECRET=your-eshopbox-secret
# Note: Typo preserved for compatibility
ESOPBOX_SECRRET=your-eshopbox-secret
ESHOPBOX_REFRESH_TOKEN=your-eshopbox-refresh-token
ESHOPBOX_BASE_URL=https://wild-n-root.myeshopbox.com

# Shipping API Configuration
SHIPPING_API_BASE=https://wild-n-root.myeshopbox.com
SHIPPING_API_TOKEN=your-shipping-api-token-optional

# CORS Configuration (comma-separated regex patterns)
# Include all domains that need API access: frontend, admin panel, etc.
CORS_ORIGINS=^https://wildnroot\.com$,^https://www\.wildnroot\.com$,^https://admin\.wildnroot\.com$,^https://wnrclient-zgyo\.vercel\.app$

# API Base URL (for internal API calls)
API_BASE_URL=http://localhost:5001

# Optional: Local uploads directory (if not using Cloudinary)
# LOCAL_UPLOADS_DIR=uploads
