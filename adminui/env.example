# Admin UI Environment Variables
# Copy this file to .env.local and update with your production values

# Backend API Base URL
# For Docker deployment (internal container communication): http://backend:5001
# For production (public URL used by browser): https://api.wildnroot.com
# For local development: http://localhost:5001
NEXT_PUBLIC_API_BASE=http://localhost:5001

# Admin Panel URL (optional - for canonical URLs, redirects, etc.)
# NEXT_PUBLIC_ADMIN_URL=https://admin.wildnroot.com

# Firebase Configuration (if needed)
# NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_auth_domain
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_storage_bucket
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
